    {
        "id": "7ac0d4e283911b65",
        "type": "function",
        "z": "f9d5dd2c9282c97b",
        "name": "Preparar marcador ISS",
        "func": "let position;\n\ntry {\n  position = JSON.parse(msg.payload.value);\n} catch (error) {\n  node.error(\"Evento de posición no es JSON válido\", msg);\n  return null;\n}\n\nif (position.norad_id !== \"25544\" || ![position.lat, position.lon, position.altitude_km].every(Number.isFinite)) {\n  node.error(\"Evento de posición de la ISS incompleto\", msg);\n  return null;\n}\n\nmsg.payload = {\n  name: position.name,\n  lat: position.lat,\n  lon: position.lon,\n  alt: position.altitude_km * 1000,\n  altitude_km: Number(position.altitude_km.toFixed(1)),\n  norad_id: position.norad_id,\n  calculated_at: position.calculated_at,\n  icon: \"iss\",\n  iconColor: \"red\",\n  layer: \"Satélites\",\n  tooltip: `${position.name} · ${position.altitude_km.toFixed(0)} km`,\n  ttl: 20\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
