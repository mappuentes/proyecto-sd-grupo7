    {
        "id": "29479e1f8aa041d2",
        "type": "function",
        "z": "f9d5dd2c9282c97b",
        "name": "Guardar órbita ISS",
        "func": "let event;\n\ntry {\n  event = JSON.parse(msg.payload.value);\n} catch (error) {\n  node.error(\"Evento orbital no es JSON válido\", msg);\n  return null;\n}\n\nif (event.norad_id !== \"25544\" || !event.omm) {\n  node.error(\"Evento orbital de la ISS incompleto\", msg);\n  return null;\n}\n\nconst satrec = satellite.json2satrec(event.omm);\nif (satrec.error !== 0) {\n  node.error(`SGP4 rechazó la órbita: error ${satrec.error}`, msg);\n  return null;\n}\n\nflow.set(\"issOrbit\", {\n  satrec,\n  norad_id: event.norad_id,\n  name: event.name,\n  epoch: event.epoch\n});\nnode.status({ fill: \"green\", shape: \"dot\", text: `órbita ${event.epoch}` });\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "satellite",
                "module": "satellite.js"
            }
        ],
        "x": 520,
        "y": 200,
        "wires": [
            []
        ]
    },
    {
        "id": "f6b15c030f3d25ab",
        "type": "inject",
