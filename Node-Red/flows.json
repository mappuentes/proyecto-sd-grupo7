    {
        "id": "e36f7a57d290741c",
        "type": "function",
        "z": "f9d5dd2c9282c97b",
        "name": "Calcular posición ISS (SGP4)",
        "func": "const orbit = flow.get(\"issOrbit\");\nif (!orbit) {\n  node.status({ fill: \"yellow\", shape: \"ring\", text: \"esperando órbita\" });\n  return null;\n}\n\nconst now = new Date();\nconst propagated = satellite.propagate(orbit.satrec, now);\nif (!propagated || !propagated.position) {\n  node.error(\"SGP4 no pudo calcular la posición de la ISS\", msg);\n  return null;\n}\n\nconst geodetic = satellite.eciToGeodetic(propagated.position, satellite.gstime(now));\nconst position = {\n  schema_version: \"1.0\",\n  norad_id: orbit.norad_id,\n  name: orbit.name,\n  calculated_at: now.toISOString(),\n  orbit_epoch: orbit.epoch,\n  lat: satellite.degreesLat(geodetic.latitude),\n  lon: satellite.degreesLong(geodetic.longitude),\n  altitude_km: geodetic.height\n};\n\nmsg.key = orbit.norad_id;\nmsg.payload = JSON.stringify(position);\nnode.status({ fill: \"green\", shape: \"dot\", text: `${position.lat.toFixed(2)}, ${position.lon.toFixed(2)}` });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "satellite",
                "module": "satellite.js"
            }
        ],
        "x": 550,
        "y": 260,
        "wires": [
            [
                "a889d216c8b10fa4",
                "6d5b7644f3a109cf"
            ]
