    {
        "id": "db0eb39528b07683",
        "type": "function",
        "z": "f9d5dd2c9282c97b",
        "name": "Validar y crear evento ISS",
        "func": "if (msg.statusCode !== 200) {\n  node.error(`CelesTrak respondió con HTTP ${msg.statusCode}`, msg);\n  return null;\n}\n\nconst sats = Array.isArray(msg.payload) ? msg.payload : [];\nconst iss = sats.find(sat => String(sat.NORAD_CAT_ID) === \"25544\");\n\nif (!iss) {\n  node.error(\"CelesTrak no devolvió la ISS (NORAD 25544)\", msg);\n  return null;\n}\n\nmsg.key = \"25544\";\nmsg.payload = JSON.stringify({\n  schema_version: \"1.0\",\n  norad_id: \"25544\",\n  name: iss.OBJECT_NAME,\n  epoch: iss.EPOCH,\n  source: \"celestrak:gp\",\n  group: \"stations\",\n  ingested_at: new Date().toISOString(),\n  omm: iss\n});\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 100,
        "wires": [
            [
                "c7c8283377a75cc4",
                "2722967dde7cd652"
            ]
        ]
