    {
        "id": "db0eb39528b07683",
        "type": "function",
        "z": "f9d5dd2c9282c97b",
        "name": "construir-tle-messages",
        "func": "if (msg.statusCode !== undefined && msg.statusCode !== 200) {\n  node.error(`CelesTrak respondió con HTTP ${msg.statusCode}`, msg);\n  return null;\n}\n\nconst sats = Array.isArray(msg.payload) ? msg.payload : [msg.payload];\n\nmsg.payload = sats.map(o => ({\n  key: String(o.NORAD_CAT_ID),\n  value: JSON.stringify({\n    schema_version: \"1.0\",\n    norad_id: String(o.NORAD_CAT_ID),\n    name: o.OBJECT_NAME,\n    epoch: o.EPOCH,\n    source: \"celestrak:gp\",\n    group: \"stations\",\n    ingested_at: new Date().toISOString(),\n    omm: o\n  })\n}));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 100,
