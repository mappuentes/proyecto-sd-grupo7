    {
        "id": "391e8bc986aa4d0b",
        "type": "function",
        "z": "f9d5dd2c9282c97b",
        "name": "pintar-satelites",
        "func": "let raw = msg.payload;\nif (raw && typeof raw === \"object\" && raw.value !== undefined) {\n  raw = raw.value;\n}\n\nlet data;\ntry {\n  data = (typeof raw === \"string\") ? JSON.parse(raw) : raw;\n} catch (e) {\n  node.warn(\"value no es JSON: \" + raw);\n  return null;\n}\n\nif (![data.lat, data.lon].every(Number.isFinite)) {\n  return null;\n}\n\nconst alt = Number.isFinite(data.alt_km) ? Math.round(data.alt_km) + \" km\" : \"n/d\";\nconst vel = Number.isFinite(data.velocity_kms) ? data.velocity_kms.toFixed(2) + \" km/s\" : \"n/d\";\n\nfunction colorPorGrupo(d) {\n  const n = (d.name || \"\").toUpperCase();\n  if (n.includes(\"STARLINK\")) return \"cyan\";\n  if (n.includes(\"GPS\"))      return \"yellow\";\n  if (n.includes(\"GALILEO\"))  return \"orange\";\n  if (n.includes(\"ISS\"))      return \"red\";\n  return \"lime\";\n}\n\nmsg.payload = {\n  name: data.name || data.norad_id,\n  lat: data.lat,\n  lon: data.lon,\n  icon: \"satellite\",\n  iconColor: colorPorGrupo(data),\n  layer: \"Satelites\",\n  label: data.name,\n  ttl: 30,\n  popup: `${data.name}<br>alt: ${alt}<br>vel: ${vel}`\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
