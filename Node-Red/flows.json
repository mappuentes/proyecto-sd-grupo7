    {
        "id": "db0eb39528b07683",
        "type": "function",
        "z": "f9d5dd2c9282c97b",
        "name": "prueba_json_api",
        "func": "const sats = Array.isArray(msg.payload) ? msg.payload : [msg.payload];\nconst iss = sats.find(o => String(o.NORAD_CAT_ID) === \"25544\") || sats[0];\n\nif (!iss) { node.warn(\"Celestrak no devolvió datos\"); return null; }\n\nmsg.key = String(iss.NORAD_CAT_ID);\nmsg.payload = JSON.stringify({\n  schema_version: \"1.0\",\n  norad_id: String(iss.NORAD_CAT_ID),\n  name: iss.OBJECT_NAME,\n  epoch: iss.EPOCH,\n  source: \"celestrak:gp\",\n  group: \"stations\",\n  ingested_at: new Date().toISOString(),\n  omm: iss\n});\nreturn msg;",
